# Reverse proxy / public host settings used by docker-compose
HOST=budget.example.com
PROXY_HOST=home-server_proxy-tier
LE_EMAIL=you@example.com

# Payload / database
DATABASE_URI=mongodb://mongo/budget
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Teller Connect frontend
# Required to use the Teller linking flow in the admin UI.
NEXT_PUBLIC_TELLER_APP_ID=
# Optional. Defaults to "development".
NEXT_PUBLIC_TELLER_ENV=development

# Ollama transaction insight settings
# Optional. docker-compose defaults the service URL to http://ollama:11434.
OLLAMA_URL=http://ollama:11434
# Optional. docker-compose defaults to gemma4:e2b if not set.
OLLAMA_MODEL=gemma4:e2b
